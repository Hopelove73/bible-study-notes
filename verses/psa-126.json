  "verses": [
    {
      "n": 1,
      "text": "（上行之诗）当耶和华将那些被掳的带回锡安的时候，我们好像作梦的人。"
    },
    {
      "n": 2,
      "text": "我们满口喜笑、满舌欢呼的时候，外邦中就有人说：耶和华为他们行了大事！"
    },
    {
      "n": 3,
      "text": "耶和华果然为我们行了大事，我们就欢喜。"
    },
    {
      "n": 4,
      "text": "耶和华阿，求你使我们被掳的人归回，好像南地的河水复流。"
    },
    {
      "n": 5,
      "text": "流泪撒种的，必欢呼收割！"
    },
    {
      "n": 6,
      "text": "那带种流泪出去的，必要欢欢乐乐的带禾捆回来！"
    }
  ]
}
