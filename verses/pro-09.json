  "id": "pro-09",
  "book": "箴言",
  "book_code": "PRO",
  "chapter": 9,
  "count": 18,
  "source": "https://bible-api.com/data/cuv/PRO/9",
  "converted": "zhconv",
  "fetched": "2026-10-22",
  "verses": [
    {
      "n": 1,
      "text": "智慧建造房屋，凿成七根柱子，"
    },
    {
      "n": 2,
      "text": "宰杀牲畜，调和旨酒，设摆筵席；"
    },
    {
      "n": 3,
      "text": "打发使女出去，自己在城中至高处呼叫，"
    },
    {
      "n": 4,
      "text": "说：谁是愚蒙人，可以转到这里来！又对那无知的人说："
    },
    {
      "n": 5,
      "text": "你们来，吃我的饼，喝我调和的酒。"
    },
    {
      "n": 6,
      "text": "你们愚蒙人，要舍弃愚蒙，就得存活，并要走光明的道。"
    },
    {
      "n": 7,
      "text": "指斥亵慢人的，必受辱骂；责备恶人的，必被玷污。"
    },
    {
      "n": 8,
      "text": "不要责备亵慢人，恐怕他恨你；要责备智慧人，他必爱你。"
    },
    {
      "n": 9,
      "text": "教导智慧人，他就越发有智慧；指示义人，他就增长学问。"
    },
    {
      "n": 10,
      "text": "敬畏耶和华是智慧的开端；认识至圣者便是聪明。"
    },
    {
      "n": 11,
      "text": "你藉着我，日子必增多，年岁也必加添。"
    },
    {
      "n": 12,
      "text": "你若有智慧，是与自己有益；你若亵慢，就必独自担当。"
    },
    {
      "n": 13,
      "text": "愚昧的妇人喧嚷；她是愚蒙，一无所知。"
    },
    {
      "n": 14,
      "text": "她坐在自己的家门口，坐在城中高处的座位上，"
    },
    {
      "n": 15,
      "text": "呼叫过路的，就是直行其道的人，"
    },
    {
      "n": 16,
      "text": "说：谁是愚蒙人，可以转到这里来！又对那无知的人说："
    },
    {
      "n": 17,
      "text": "偷来的水是甜的，暗吃的饼是好的。"
    },
    {
      "n": 18,
      "text": "人却不知有阴魂在她那里；她的客在阴间的深处。"
    }
  ]
}
